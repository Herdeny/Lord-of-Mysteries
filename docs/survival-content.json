    {"id": "silver", "parent": "salt", "item": "silver_filings", "title": "银色的细屑", "en": "Silver Traces", "description": "获得银屑；石镐及以上可采银纹矿，精准采集后也可熔炼。", "description_en": "Obtain Silver Filings. Mine Argent Ore with stone tools or better, or smelt silk-touched ore."},
    {"id": "mortar", "parent": "root", "item": "mystic_mortar", "title": "动手研磨", "en": "Hands-on Alchemy", "description": "获得研钵。主手原料、副手试剂，右键加工；/pm survival recipes 查询。", "description_en": "Obtain a Mystic Mortar. Main-hand material plus offhand reagent; right-click. See /pm survival recipes."},
    {"id": "ink", "parent": "mortar", "item": "mystic_ink", "title": "记录未知", "en": "Record the Unknown", "description": "获得神秘墨水；墨囊与灵性草，或荧光墨囊与灰烬粉可研磨。", "description_en": "Obtain Mystic Ink. Grind ink with Spirit Herb, or glow ink with Ash Powder."},
    {"id": "candle", "parent": "mortar", "item": "white_candle", "title": "第一缕烛火", "en": "First Candlelight", "description": "获得白蜡烛；蜂脾与线可在研钵中加工，不消耗蜂巢。", "description_en": "Obtain a White Candle. Grind honeycomb with string; no hive is consumed."},
    {"id": "incense", "parent": "heather", "item": "calming_incense", "title": "在低语之前", "en": "Before the Whispers", "description": "准备安神熏香；先学习恢复途径，再尝试危险仪式。", "description_en": "Prepare Calming Incense. Learn recovery options before attempting dangerous rituals."},
